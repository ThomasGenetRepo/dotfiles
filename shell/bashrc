# ~/.bashrc managed by ~/src/dotfiles

case $- in
*i*) ;;
*) return ;;
esac

# History: append on exit instead of overwriting, keep a lot of it, and
# skip duplicates / space-prefixed commands. (This bashrc replaces the
# distro default, so these must be set here or bash falls back to its
# bare defaults: 500 lines, clobbered per shell.)
shopt -s histappend
HISTCONTROL=ignoreboth
HISTSIZE=100000
HISTFILESIZE=200000

# Re-check the window size after each command (keeps LINES/COLUMNS right
# after a tmux pane resize).
shopt -s checkwinsize

# Dotfiles shell config
if [ -f "$HOME/src/dotfiles/shell/env.sh" ]; then
  . "$HOME/src/dotfiles/shell/env.sh"
fi

if [ -f "$HOME/src/dotfiles/shell/aliases.sh" ]; then
  . "$HOME/src/dotfiles/shell/aliases.sh"
fi

if [ -f "$HOME/src/dotfiles/shell/functions.sh" ]; then
  . "$HOME/src/dotfiles/shell/functions.sh"
fi

if [ -f "$HOME/src/dotfiles/shell/prompt.sh" ]; then
  . "$HOME/src/dotfiles/shell/prompt.sh"
fi

# Programmable completion (git, ssh hosts, etc.)
if ! shopt -oq posix; then
  if [ -f /usr/share/bash-completion/bash_completion ]; then
    . /usr/share/bash-completion/bash_completion
  elif [ -f /etc/bash_completion ]; then
    . /etc/bash_completion
  fi
fi

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"                   # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion" # This loads nvm bash_completion

# fzf shell integration: Ctrl-R fuzzy history, Ctrl-T insert file path,
# Alt-C cd into a directory, **<Tab> fuzzy completion. (Needs fzf >= 0.48
# for --bash; older distro packages ship key-bindings.bash instead.)
if command -v fzf >/dev/null 2>&1; then
  eval "$(fzf --bash)"
fi

# zoxide: cd learns visited directories by frecency, so `cd dotf` jumps to
# ~/src/dotfiles from anywhere. --cmd cd keeps plain cd behavior for paths
# that exist; `cdi` opens an interactive fzf picker.
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init bash --cmd cd)"
fi

# Write each command to the history file as it runs, so new tmux panes see
# it immediately (a pane otherwise only flushes history on exit). Existing
# panes still don't ingest each other's entries live -- add `history -n`
# here too if that's ever wanted.
case "$PROMPT_COMMAND" in
*"history -a"*) ;;
*) PROMPT_COMMAND="${PROMPT_COMMAND:+$PROMPT_COMMAND; }history -a" ;;
esac

# Machine-local config not tracked in git (work env vars, per-machine
# paths, secrets). Kept last so it can override anything above.
if [ -f "$HOME/.bashrc.local" ]; then
  . "$HOME/.bashrc.local"
fi
